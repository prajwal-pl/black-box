{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch index.ts",
    "build": "bun --bun run prisma generate",
    "trigger:dev": "npx trigger.dev@latest dev",
    "trigger:deploy": "npx trigger.dev@latest deploy",
    "test": "bun test tests/processors/processors.test.ts",
    "test:watch": "bun test --watch tests/**/*.test.ts",
    "test:integration": "bun test tests/processors/integration.test.ts --timeout 900000",
    "test:all": "bun test tests/processors/processors.test.ts && bun test tests/processors/integration.test.ts --timeout 900000"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "prisma": "^7.8.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@langchain/core": "^1.2.3",
    "@langchain/fireworks": "^0.2.5",
    "@langchain/groq": "^1.3.1",
    "@langchain/qdrant": "^1.0.3",
    "@langchain/textsplitters": "^1.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@trigger.dev/build": "4.5.11",
    "@trigger.dev/sdk": "4.5.11",
    "bcrypt": "^6.0.0",
    "canvas": "^3.2.3",
    "cors": "^2.8.6",
    "deepagents": "^1.11.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.5.3",
    "multer": "^2.2.0",
    "neo4j-driver": "^6.1.0",
    "pdf-parse": "^2.4.5",
    "pdf-poppler": "^0.2.3",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.21.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.1",
