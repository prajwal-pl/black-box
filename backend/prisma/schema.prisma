generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum CaseStatus {
    ACTIVE
    ARCHIVED
    CLOSED
}

enum HypothesisStatus {
    ACTIVE
    CONFIRMED
    REJECTED
}

enum Severity {
    LOW
    MEDIUM
    HIGH
    CRITICAL
}

enum EvidenceStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
}

enum TeamRole {
    OWNER
    EDITOR
    VIEWER
}

enum ContradictionSeverity {
    LOW
    MEDIUM
    HIGH
    VERY_HIGH
}

enum ContradictionStatus {
    OPEN
    RESOLVED
    DISMISSED
}

model User {
    id       String  @id @default(uuid())
    email    String  @unique
    name     String?
    image    String?
    password String

    cases           Case[]
    teamMemberships TeamMember[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Team {
    id   String @id @default(uuid())
    name String

    members TeamMember[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model TeamMember {
    userId String
    teamId String
    role   TeamRole @default(VIEWER)

    user User @relation(fields: [userId], references: [id])
    team Team @relation(fields: [teamId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@id([userId, teamId])
}

model Case {
    id             String           @id @default(uuid())
    name           String
    status         CaseStatus       @default(ACTIVE)
    user           User             @relation(fields: [userId], references: [id])
    userId         String
    severity       Severity         @default(LOW)
    evidence       Evidence[]
    hypotheses     Hypothesis[]
    contradictions Contradictions[]
    timelineEvents TimelineEvent[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Evidence {
    id          String         @id @default(uuid())
    caseId      String
    description String?
    fileName    String
    fileUrl     String
    mimeType    String
    storageKey  String
    status      EvidenceStatus @default(PENDING)
    case        Case           @relation(fields: [caseId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Contradictions {
    id          String              @id @default(uuid())
    caseId      String
    title       String
    description String
    severity    Severity            @default(LOW)
    status      ContradictionStatus @default(OPEN)
    evidenceIds String[]
    case        Case                @relation(fields: [caseId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model TimelineEvent {
    id          String    @id @default(uuid())
    caseId      String
    title       String
    description String
    evidenceId  String
    occuredAt   DateTime?
    confidence  Float
    case        Case      @relation(fields: [caseId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Hypothesis {
    id         String           @id @default(uuid())
    caseId     String
    content    String
    confidence Float
    status     HypothesisStatus @default(ACTIVE)
    case       Case             @relation(fields: [caseId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
